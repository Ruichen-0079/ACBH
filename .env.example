# ACBH environment variables
# Copy to .env and adjust. DO NOT commit .env with real secrets.

# ── Coordinator ──────────────────────────────────
PORT=6121
HOST=0.0.0.0
ACBH_STORAGE_ROOT=.acbh-storage
# Optional: set to a file path to enable state persistence across restarts
# ACBH_COORDINATOR_STATE_PATH=./data/coordinator-state.json

# ── Optional tuning (defaults shown) ─────────────
# ACBH_HOST_HEARTBEAT_TIMEOUT_MS=30000
# ACBH_TAKEOVER_ASSIGNMENT_TTL_MS=60000
# ACBH_ARTIFACT_RETENTION_PER_KIND=5
# ACBH_GC_MIN_AGE_MS=3600000
# ACBH_TUNNEL_SESSION_TTL_MS=300000
# ACBH_MAX_OBJECT_BYTES=268435456

# ── Agent (RCON password, optional) ──────────────
# ACBH_RCON_PASSWORD=change-me
