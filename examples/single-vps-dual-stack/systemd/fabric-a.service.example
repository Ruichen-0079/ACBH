[Unit]
Description=Fabric A backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minecraft
WorkingDirectory=/opt/mc-stack/fabric-a
ExecStart=/usr/bin/java -Xms1G -Xmx2G -jar fabric-server-launch.jar nogui
Restart=on-failure
RestartSec=10
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
